#!/bin/sh
set -eu

DOCKER_SOCKET=/var/run/docker.sock

if docker -H "unix://${DOCKER_SOCKET}" info >/dev/null 2>&1; then
  echo "Docker is already running."
  exit 0
fi

dockerd --data-root=/tmp/docker >/tmp/dockerd.log 2>&1 &

printf "Starting Docker"
i=0
while ! docker -H "unix://${DOCKER_SOCKET}" info >/dev/null 2>&1; do
  i=$((i + 1))
  if [ "$i" -ge 60 ]; then
    echo
    cat /tmp/dockerd.log
    exit 1
  fi
  printf "."
  sleep 1
done
echo " ready"
